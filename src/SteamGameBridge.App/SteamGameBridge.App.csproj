<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SteamGameBridge</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.2.1</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SteamGameBridge.Core/SteamGameBridge.Core.csproj" />
    <EmbeddedResource Include="../../assets/SteamPlaceholder.exe" LogicalName="SteamPlaceholder.exe" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="Licenses.Project.txt" />
  </ItemGroup>
  <Target Name="EmbedRuntimeLicenses" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveFrameworkReferences" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_CoreLicensePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
      <_DesktopLicensePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.WindowsDesktop.App'" />
      <EmbeddedResource Include="@(_CoreLicensePack->'%(PackageDirectory)/LICENSE.TXT')" LogicalName="Licenses.NETCore.txt" />
      <EmbeddedResource Include="@(_CoreLicensePack->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" LogicalName="Licenses.NETCore.ThirdParty.txt" />
      <EmbeddedResource Include="@(_DesktopLicensePack->'%(PackageDirectory)/LICENSE')" LogicalName="Licenses.WindowsDesktop.txt" />
    </ItemGroup>
    <Error Condition="'@(_CoreLicensePack)' == '' Or '@(_DesktopLicensePack)' == ''" Text="Runtime license packs were not resolved." />
  </Target>
</Project>
