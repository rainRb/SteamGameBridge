<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/SteamGameBridge.App/*.cs" Exclude="../../src/SteamGameBridge.App/Program.cs" Link="App/%(Filename)%(Extension)" />
    <ProjectReference Include="../../src/SteamGameBridge.Core/SteamGameBridge.Core.csproj" />
    <EmbeddedResource Include="../../assets/SteamPlaceholder.exe" LogicalName="SteamPlaceholder.exe" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="Licenses.Project.txt" />
  </ItemGroup>
</Project>
